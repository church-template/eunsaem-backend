# 멀티테넌시(#86) — 첫 교회. V18 마이그레이션이 churches 첫 행을 만들 때 한 번 읽는다(필수).
# 첫 교회의 프론트 주소는 아래 CORS_ALLOWED_ORIGIN을 쓴다.
# ★ CHURCH_NAME·CHURCH_SLUG·CORS_ALLOWED_ORIGIN은 지우지 말 것 — 값이 없으면 compose와 앱이 기동을 거부한다.
#   (첫 기동 뒤에는 값을 바꿔도 아무 영향이 없다. 두 번째 교회부터는 scripts/new-church.sh로 등록하며 .env를 건드리지 않는다.)
CHURCH_NAME=개발교회
CHURCH_SLUG=dev              # 소문자·숫자·하이픈, 1~40자. API 경로 접두사 /church/<slug>에 쓰인다
# 접두사 없는 /api/** 요청을 처리할 교회(로컬·전환 기간 전용). 비우면 그런 요청은 404.
# churches에 없는 slug를 넣으면 기동이 실패한다.
TENANT_DEFAULT_SLUG=dev

# PostgreSQL
DB_NAME=church_db
DB_URL=jdbc:postgresql://postgres:5432/church_db
DB_USERNAME=church_user
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — 플랫폼 전체에 하나(전 교회 공용). 유출되면 전 교회 토큰을 위조할 수 있으니 강한 랜덤 값으로.
JWT_SECRET=
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=1209600

# 첫 교회의 프론트 origin — V18이 churches 첫 행의 frontend_origin으로 한 번 읽는다. 지우지 말 것(위 ★).
# 런타임 CORS는 이 값이 아니라 요청 교회의 churches.frontend_origin으로 정해진다.
CORS_ALLOWED_ORIGIN=https://example.kr

# 파일 저장
FILE_UPLOAD_DIR=/app/uploads
FILE_BASE_URL=https://example.kr/api/media   # 바인딩만 되고 읽는 코드가 없다(죽은 설정)
FILE_MAX_SIZE=10485760       # 업로드 최대 크기(바이트). 운영자 조정값, 기본 10MB. 초과 시 업로드 거부

# Swagger 노출 (기본 on. 공개 서버에서 API 구조 노출을 막으려면 false로 토글)
SWAGGER_ENABLED=true

# 캐시/조회수 (스펙 §9)
CACHE_TTL=60                 # 캐시 TTL(초). /api/main 통합 조회
VIEW_FLUSH_INTERVAL=60000    # 조회수 버퍼 → DB 반영 주기(밀리초)

# 통독 챌린지 (설계 2026-07-06)
APP_TIMEZONE=Asia/Seoul      # "오늘" 판정 기준 시간대(읽음 기록·스트릭·챌린지 상태)
